{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Development",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "envFile": "${workspaceFolder}/backend/.env.development",
      "console": "integratedTerminal",
      "preLaunchTask": "pip-install"
    },
    {
      "name": "FastAPI: Testing",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8001"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "envFile": "${workspaceFolder}/backend/.env.testing",
      "console": "integratedTerminal",
      "preLaunchTask": "pip-install"
    },
    {
      "name": "FastAPI: Production",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "envFile": "${workspaceFolder}/backend/.env.production",
      "console": "integratedTerminal",
      "preLaunchTask": "pip-install"
    }
  ]
}
