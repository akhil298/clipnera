{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@timeline": [
        "../frontend/lib/editor/timeline.ts"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "e2e/**/*",
    "../frontend/lib/editor/timeline.ts",
    "e2e-real/**/*"
  ]
}
