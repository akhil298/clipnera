{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@timeline": [
        "../frontend/lib/editor/timeline.ts"
      ]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/window.ts",
    "src/shared/**/*",
    "../frontend/lib/editor/timeline.ts"
  ]
}
